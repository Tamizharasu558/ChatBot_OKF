# ==========================================
# OKF-Powered Knowledge Chatbot Configuration
# ==========================================

# Application Environment
APP_ENV=development

# LLM Provider: 'mock' (default, offline & test mode), 'groq', or 'ollama'
LLM_PROVIDER=mock

# Groq API Configuration (required if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Paths & Storage
KNOWLEDGE_DIR=knowledge
DATABASE_URL=data/okf_chat.db

# Retrieval Tuning
BM25_K1=1.5
BM25_B=0.75
MAX_RETRIEVAL_PASSAGES=5
MIN_RELEVANCE_SCORE=0.8
